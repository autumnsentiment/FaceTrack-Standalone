<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- 摄像头预览 - 全屏 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部状态栏 - 浮动 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="模型加载中..."
        android:textColor="#00FF00"
        android:textSize="11sp"
        android:padding="4dp"
        android:paddingStart="8dp"
        android:gravity="start"
        android:background="#66000000"
        android:layout_gravity="top" />

    <!-- 浮动设置按钮 - 右下角 -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="12dp"
        android:src="@android:drawable/ic_menu_manage"
        android:background="#88000000"
        android:contentDescription="设置"
        android:scaleType="centerInside"
        android:padding="8dp" />

    <!-- 浮动摄像头开关按钮 - 左下角 -->
    <ImageButton
        android:id="@+id/btnCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:src="@android:drawable/ic_menu_camera"
        android:background="#88000000"
        android:contentDescription="摄像头"
        android:scaleType="centerInside"
        android:padding="8dp" />

    <!-- 浮动切换摄像头按钮 - 左下角偏右 -->
    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="64dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:background="#88000000"
        android:contentDescription="切换摄像头"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:visibility="gone" />

    <!-- 浮动校准按钮 - 右下角偏左 -->
    <ImageButton
        android:id="@+id/btnOpenCalibration"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="64dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_menu_compass"
        android:background="#88000000"
        android:contentDescription="校准"
        android:scaleType="centerInside"
        android:padding="8dp" />

    <!-- 二级菜单面板 - 推流配置 (不含校准) -->
    <LinearLayout
        android:id="@+id/settingsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#DD222222"
        android:padding="12dp"
        android:visibility="gone">

        <!-- 标题栏 + 关闭按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="推流配置"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnClosePanel"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="#00000000"
                android:contentDescription="关闭"
                android:scaleType="centerInside"
                android:padding="4dp" />
        </LinearLayout>

        <!-- OSC 地址行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OSC 地址"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <EditText
                android:id="@+id/etOscHost"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="2"
                android:text="127.0.0.1"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#333333"
                android:padding="6dp"
                android:inputType="textUri"
                android:singleLine="true"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="端口"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <EditText
                android:id="@+id/etOscPort"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="9000"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#333333"
                android:padding="6dp"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 推理硬件选择行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="推理硬件"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <Spinner
                android:id="@+id/spinnerBackend"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="#333333"
                android:paddingStart="8dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/tvBackendInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFAA00"
                android:textSize="10sp"
                android:layout_marginStart="6dp"
                android:maxWidth="100dp" />
        </LinearLayout>

        <!-- VMC 端口行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VMC 端口"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <EditText
                android:id="@+id/etVmcPort"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="39539"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#333333"
                android:padding="6dp"
                android:inputType="number"
                android:singleLine="true" />
        </LinearLayout>

        <!-- 眼部灵敏度行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="眼部灵敏度"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <SeekBar
                android:id="@+id/seekBarEyeSensitivity"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="30"
                android:progress="10"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/tvEyeSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="32dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 嘴部灵敏度行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="嘴部灵敏度"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <SeekBar
                android:id="@+id/seekBarMouthSensitivity"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:max="30"
                android:progress="10"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/tvMouthSensitivity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.0"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:minWidth="32dp"
                android:gravity="center" />
        </LinearLayout>

        <!-- 镜像开关行 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="画面镜像"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:minWidth="64dp" />

            <Switch
                android:id="@+id/switchMirror"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="镜像翻转"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="外接摄像头验证"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/btnStartUvcValidation"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="启动三路验证"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnStopUvcValidation"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="停止验证"
                android:textSize="12sp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUvcSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 未启动"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="左眼"
                    android:textColor="#DDDDDD"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerUvcLeftEye"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="右眼"
                    android:textColor="#DDDDDD"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerUvcRightEye"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:text="嘴部"
                    android:textColor="#DDDDDD"
                    android:textSize="11sp" />

                <Spinner
                    android:id="@+id/spinnerUvcMouth"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="138dp"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="4dp">

                <com.serenegiant.widget.UVCCameraTextureView
                    android:id="@+id/uvcPreviewLeftEye"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/tvUvcLeftEye"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="左眼: 未连接"
                    android:textColor="#DDDDDD"
                    android:textSize="10sp"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

                <com.serenegiant.widget.UVCCameraTextureView
                    android:id="@+id/uvcPreviewRightEye"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/tvUvcRightEye"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="右眼: 未连接"
                    android:textColor="#DDDDDD"
                    android:textSize="10sp"
                    android:paddingTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="4dp">

                <com.serenegiant.widget.UVCCameraTextureView
                    android:id="@+id/uvcPreviewMouth"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#111111" />

                <TextView
                    android:id="@+id/tvUvcMouth"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="嘴部: 未连接"
                    android:textColor="#DDDDDD"
                    android:textSize="10sp"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 启动推流按钮 -->
        <Button
            android:id="@+id/btnStartStop"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="启动推流"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- 校准面板 - 全屏覆盖 -->
    <LinearLayout
        android:id="@+id/calibrationPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#CC222222"
        android:visibility="gone">

        <!-- 标题栏 (固定不滚动) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="校准"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseCalibration"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="#00000000"
                android:contentDescription="返回"
                android:scaleType="centerInside"
                android:padding="4dp" />
        </LinearLayout>

        <!-- 可滚动内容区 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

        <!-- 校准状态显示 -->
        <TextView
            android:id="@+id/tvCalibStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="请先开启摄像头并检测到面部"
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- 眼部校准区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="眼部校准"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正视前方时点击「瞳孔居中校准」，将当前瞳孔位置设为视线中心"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnCalibratePupil"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="瞳孔居中校准"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnResetPupilCalib"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="重置"
                android:textSize="12sp"
                android:minWidth="64dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPupilCalibInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 未校准"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="眼睛识别范围校准"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="用当前识别值设置推流最小/最大幅度，只影响 OSC/VMC 推流"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnEyeRangeMin"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="当前设为最小值"
                android:textSize="12sp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnEyeRangeMax"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="当前设为最大值"
                android:textSize="12sp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnResetEyeRange"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="重置"
                android:textSize="12sp"
                android:minWidth="64dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEyeRangeInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 未设置"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <!-- 眼部取负开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Switch
                android:id="@+id/switchInvertEyeX"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="X轴取负"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchInvertEyeY"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Y轴取负"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启后眼部视线数据取负值推流，用于修正视线方向相反问题"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:layout_marginBottom="8dp" />

        <!-- 双眼同步开关 -->
        <Switch
            android:id="@+id/switchSyncEyes"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="双眼同步"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="开启后右眼数据复制左眼，解决模型仅左眼运动问题"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:layout_marginBottom="8dp" />

        <!-- 合并眼部参数开关 -->
        <Switch
            android:id="@+id/switchSendMergedEyes"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:text="发送合并眼部参数"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="发送 EyesX/EyesY 合并值（部分模型合并值仅驱动左眼，默认关闭）"
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:layout_marginBottom="16dp" />

        <!-- 嘴部校准区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="嘴部校准"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 闭嘴时点击「闭合校准」\n2. 最大张嘴时点击「最大值校准」"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnMouthClosed"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="闭合校准"
                android:textSize="13sp"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnMouthMaxOpen"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="最大值校准"
                android:textSize="13sp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <Button
                android:id="@+id/btnResetMouthCalib"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="重置嘴部校准"
                android:textSize="12sp"
                android:minWidth="120dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMouthCalibInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="状态: 未校准"
            android:textColor="#FFAA00"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <!-- 实时数据区 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="实时数据"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvCalibRealtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待面部检测..."
            android:textColor="#00FF00"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</FrameLayout>
